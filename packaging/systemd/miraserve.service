# Generated by `miraserve service generate --target systemd`
# Hardened unprivileged systemd unit for MiraServe (Linux Landlock + seccomp-bpf + CAP_NET_BIND_SERVICE)

[Unit]
Description=MiraServe Memory-Safe Post-Quantum HTTPS & AI Edge Server
Documentation=https://github.com/miraserve/miraserve
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=miraserve
Group=miraserve
ExecStartPre="/usr/bin/miraserve" check --fs --acme-dir "/var/lib/miraserve/acme" "/etc/miraserve/conf/miraserve.kdl"
ExecStart="/usr/bin/miraserve" run "/etc/miraserve/conf/miraserve.kdl" --acme-dir "/var/lib/miraserve/acme" --pid-file /run/miraserve/miraserve.pid
ExecReload="/usr/bin/miraserve" reload --pid-file /run/miraserve/miraserve.pid --acme-dir "/var/lib/miraserve/acme" --config "/etc/miraserve/conf/miraserve.kdl"
KillSignal=SIGTERM
# Derived from `server.timeouts.graceful-drain` + 15s grace (override with `--graceful-drain <secs>`).
TimeoutStopSec=45s
Restart=on-failure
RestartSec=3s
LimitNOFILE=1048576

# Privilege separation: bind :80/:443 without ever running as UID 0 (Threat Model T2/T5)
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Filesystem & kernel confinement (layered beneath MiraServe's in-process Landlock + seccomp-bpf)
RuntimeDirectory=miraserve
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=miraserve
StateDirectoryMode=0750
# File logs (`--log-file`, `--access-log`) and their rotation go to /var/log/miraserve.
LogsDirectory=miraserve
LogsDirectoryMode=0750
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Set MemoryDenyWriteExecute=yes (via --no-wasm) if Wasmtime JIT plugins are not used.
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
# Unconditionally block worker access to the isolated `miraserve-keyd` private-key vault.
# Starter/in-process TLS certificates live under `/etc/miraserve/certs/` instead.
InaccessiblePaths=-/etc/miraserve/keys
ReadWritePaths=/var/lib/miraserve /run/miraserve
UMask=0027

[Install]
WantedBy=multi-user.target
