# Generated by `miraserve service generate --target systemd-keyd`
# Split-privilege TLS signing vault (Threat Model T2: distinct UID/GID `miraserve-keyd`;
# private keys under /etc/miraserve/keys (0700 miraserve-keyd:miraserve-keyd) never enter worker memory)

[Unit]
Description=MiraServe Split-Privilege TLS Signing Vault (miraserve-keyd)
Documentation=https://github.com/miraserve/miraserve
Before=miraserve.service

[Service]
Type=simple
User=miraserve-keyd
Group=miraserve-keyd
SupplementaryGroups=miraserve
# R5-PKG-3 & R6-PKG-1: Provision /run/miraserve-keyd via systemd-tmpfiles (2750 miraserve-keyd:miraserve)
# instead of RuntimeDirectory=, searching /etc/tmpfiles.d and /usr/lib/tmpfiles.d.
# Companion tmpfiles.d rule: d /run/miraserve-keyd 2750 miraserve-keyd miraserve -
ExecStartPre=+/usr/bin/systemd-tmpfiles --create --prefix=/run/miraserve-keyd
ExecStart="/usr/bin/miraserve" keyd --socket "/run/miraserve-keyd/keyd.sock" --config "/etc/miraserve/conf/miraserve.kdl" --allow-peer-user miraserve
KillSignal=SIGTERM
TimeoutStopSec=15s
Restart=on-failure
RestartSec=2s

# Zero capabilities (Threat Model T2)
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
# Zero network access: communicates ONLY over the 0660 + exact-UID SO_PEERCRED Unix socket
# inside /run/miraserve-keyd (2750 setgid miraserve-keyd:miraserve; only UID `miraserve` authorized).
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX

# Strict filesystem & memory isolation (/run/miraserve-keyd is managed by tmpfiles.d)
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
ReadOnlyPaths=/etc/miraserve
ReadWritePaths=-/run/miraserve-keyd
UMask=0027

[Install]
WantedBy=multi-user.target
